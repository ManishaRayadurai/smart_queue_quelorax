          ]
        },
        {
          "name": "Book Token (Scheduled Date + Time)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"visitorName\": \"John Visitor\",\n  \"phone\": \"+919999999999\",\n  \"departmentId\": {{departmentId}},\n  \"purpose\": \"Document submission\",\n  \"walkIn\": false,\n  \"slotTime\": 4102444800000,\n  \"priority\": \"normal\"\n}"
            },
            "description": "Books a token for a future scheduled date/time. `slotTime` is epoch milliseconds combining the visitor's chosen DATE and TIME (see the frontend date+time picker on the Book Token page). The example value above is a placeholder future timestamp - replace it with a real future epoch-ms value, e.g. from `Date.now() + N days`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "pm.test('Booking accepted for future slot', function () { pm.response.to.have.status(200); });",
                  "if (data.id) { pm.collectionVariables.set('tokenId', data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Book Token (Past Date/Time - Should Fail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/tokens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"visitorName\": \"John Visitor\",\n  \"phone\": \"+919999999999\",\n  \"departmentId\": {{departmentId}},\n  \"purpose\": \"Document submission\",\n  \"walkIn\": false,\n  \"slotTime\": 946684800000,\n  \"priority\": \"normal\"\n}"
            },
            "description": "Demonstrates time-based booking enforcement: `slotTime` here is a timestamp far in the past (2000-01-01), so the backend rejects the booking with 400 Bad Request and the message \"This date/time has already passed. Please choose a future date and time.\""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Past slot is rejected with 400', function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
