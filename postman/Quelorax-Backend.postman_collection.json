    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Visitor\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+919999999999\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// OTP is no longer returned in the response \u2014 it's emailed/texted for real now.",
                  "// Check your inbox/phone and paste the code into the {{otp}} collection variable, or into the request body directly, before running the next request."
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/verify-registration",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }",
                  "if (data.user) { pm.collectionVariables.set('userId', data.user.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend Registration OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/resend-registration-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.visitor@example.com\"\n}"
            },
            "description": "Sends a fresh OTP for a registration that hasn't been verified yet. Returns 404 if there's no pending registration for that email, or 409 if it's already verified."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Resend accepted', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
