        {
          "name": "Google Sign-In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/google",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"{{google_id_token}}\"\n}"
            },
            "description": "Body must contain a real Google ID token (JWT) from Google Identity Services on the frontend \u2014 Postman cannot mint one itself. Open the frontend, sign in with Google, and copy the `credential` value it sends to /api/auth/google (e.g. via browser devtools Network tab) into the `google_id_token` collection variable. First-time sign-in auto-creates a verified VISITOR account; existing users are logged in."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.token) { pm.collectionVariables.set('token', data.token); }",
                  "if (data.user) { pm.collectionVariables.set('userId', data.user.id); }"
                ]
              }
            }
          ]
        },
