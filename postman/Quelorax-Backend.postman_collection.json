          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8084/api/ai/predict-wait-time",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"departmentId\": 1,\n  \"priority\": \"normal\",\n  \"queuePosition\": 4\n}"
            },
            "description": "Uses trained Random Forest / XGBoost model (trained on 5,000 MySQL records) to predict exact wait time in minutes."
          }
        },
        {
          "name": "Crowd Density Forecast (AI Model)",
          "request": {
            "method": "GET",
