# NOTE: plain Spring Boot does NOT auto-load a .env file (no spring-dotenv
# dependency is in pom.xml). This file is provided for reference / for use
# with `export $(cat .env | xargs)` before running, or with `docker run
# --env-file .env`, or if you add spring-dotenv yourself.
#
# Without any of these set, application.properties already falls back to
# working defaults (H2 in-memory DB, the same Google Client ID as the
# frontend .env, OTP email/SMS skipped). You only need to fill these in to
# override those defaults (e.g. real SMTP/Twilio creds, a different DB).

# "Continue with Google" — must match VITE_GOOGLE_CLIENT_ID in the frontend .env
GOOGLE_CLIENT_ID=892918437492-nrhfmhlqk1aco4r8rm3tu5n9k541fqt2.apps.googleusercontent.com

# OTP delivery — Email (SMTP). Leave blank to skip email sending.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@quelorax.app

# OTP delivery — SMS (Twilio). Leave blank to skip SMS sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
