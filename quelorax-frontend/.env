# Frontend environment variables (Vite reads any VITE_* var at build/dev time)

# Backend API base URL
VITE_API_URL=http://localhost:8080

# "Continue with Google" — must be the SAME OAuth Client ID as
# app.google.client-id in the backend's application.properties, or Google
# token verification will fail with an audience (aud) mismatch.
# Get one at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=892918437492-nrhfmhlqk1aco4r8rm3tu5n9k541fqt2.apps.googleusercontent.com

# Firebase Cloud Messaging (push notifications) — optional. Leave these
# blank and the app simply never asks for notification permission; nothing
# breaks. To enable: Firebase Console → Project Settings → General →
# "Your apps" → add a Web app → copy these values from the SDK config.
# VITE_FIREBASE_VAPID_KEY comes from a different tab: Project Settings →
# Cloud Messaging → Web configuration → "Generate key pair".
#
# IMPORTANT: also fill in the SAME values in
# public/firebase-messaging-sw.js (that file can't read this .env — see
VITE_FIREBASE_API_KEY=AIzaSyC2Fu00bEmYH7EI6HBNNEDjWEEVRVto28o
VITE_FIREBASE_AUTH_DOMAIN=quelorax-c7741.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quelorax-c7741
VITE_FIREBASE_STORAGE_BUCKET=quelorax-c7741.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=670504215476
VITE_FIREBASE_APP_ID=1:670504215476:web:8c4c3c2a577aa34cd648e1
VITE_FIREBASE_VAPID_KEY=BNUnShdn1cPBpBIDyUnfDpkx8XICaMZ9efUVwh5brCVOULUVx-7Y29x0j7IoGUVVal-k12cXPFbkkc8G1N8Wpgs
